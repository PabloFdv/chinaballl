{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/download/(.*)",
      "destination": "/download/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
